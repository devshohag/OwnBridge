<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">
  <DataTemplate.Resources>
    <BooleanToVisibilityConverter x:Key="Vis" />
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="Icons">Segoe MDL2 Assets</FontFamily>

    <!-- Quiet outlined button -->
    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1A808080" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Main action: inverted colors follow the Visual Studio theme -->
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="Background" Value="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Text link -->
    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.PanelHyperlinkKey}}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ContentPresenter VerticalAlignment="Center" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Segmented provider switch -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="10,4">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Chip toggle (context on/off) -->
    <Style x:Key="Chip" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.GrayTextKey}}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="b" BorderThickness="1" CornerRadius="10" Padding="8,2"
                    BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.55" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Read-only, selectable text -->
    <Style x:Key="Prose" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource {x:Static styles:VsBrushes.WindowKey}}" />
      <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
      <Setter Property="BorderBrush" Value="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}" />
      <Setter Property="CaretBrush" Value="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
      <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource {x:Static styles:VsBrushes.GrayTextKey}}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </DataTemplate.Resources>

  <Grid Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"
        TextElement.Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}"
        MinWidth="320" MinHeight="360">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Padding="14,10" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Command="{Binding ShowSettingsCommand}"
                ToolTip="Settings" Margin="10,0,0,0">
          <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="14" />
        </Button>
        <!-- Logo: O pier, W truss, teal arch. Drawn as vectors so it follows the theme's text color. -->
        <Viewbox Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0">
          <Canvas Width="128" Height="128">
            <Path Data="M36,54 Q55,6 74,54" Stroke="#17A596" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Ellipse Canvas.Left="21" Canvas.Top="54" Width="30" Height="44" StrokeThickness="9"
                     Stroke="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}" />
            <Polyline Points="74,54 82,98 91,70 100,98 108,54" StrokeThickness="9" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stroke="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}" />
            <Line X1="10" Y1="104" X2="118" Y2="104" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stroke="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}" />
          </Canvas>
        </Viewbox>
        <TextBlock Text="OwnBridge" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
        <Border BorderThickness="1" CornerRadius="7" Padding="2" VerticalAlignment="Center"
                BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource Segment}" GroupName="OwnBridgeProvider" Content="ChatGPT"
                         IsChecked="{Binding IsChatGpt, Mode=TwoWay}" />
            <RadioButton Style="{StaticResource Segment}" GroupName="OwnBridgeProvider" Content="Gemini"
                         IsChecked="{Binding IsGemini, Mode=TwoWay}" />
          </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Muted}" Text="{Binding UsageText}" ToolTip="{Binding UsageText}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0,0,0" />
      </DockPanel>
    </Border>

    <!-- Context line and view switcher -->
    <Border Grid.Row="1" Padding="14,6" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource Link}" Content="Chat" Command="{Binding ShowChatCommand}" Margin="12,0,0,0" FontSize="12" />
          <Button Style="{StaticResource Link}" Content="Tasks" Command="{Binding ShowTasksCommand}" Margin="12,0,0,0" FontSize="12" />
          <Button Style="{StaticResource Link}" Content="History" Command="{Binding ShowHistoryCommand}" Margin="12,0,0,0" FontSize="12" />
          <Button Style="{StaticResource Link}" Content="New chat" Command="{Binding NewChatCommand}" Margin="12,0,0,0" FontSize="12" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Muted}" Text="{Binding WorkspaceText}" TextTrimming="CharacterEllipsis" />
          <TextBlock Style="{StaticResource Muted}" Text="  ·  " Visibility="{Binding HasTasks, Converter={StaticResource Vis}}" />
          <TextBlock Style="{StaticResource Muted}" Text="{Binding TaskHeader}" TextTrimming="CharacterEllipsis"
                     Visibility="{Binding HasTasks, Converter={StaticResource Vis}}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Content area: one view at a time -->
    <Grid Grid.Row="2">
      <!-- Chat -->
      <ScrollViewer Visibility="{Binding IsChatView, Converter={StaticResource Vis}}" VerticalScrollBarVisibility="Auto" Padding="14,14,14,6">
        <StackPanel>
          <TextBlock Style="{StaticResource Muted}" Text="{Binding EmptyText}" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0"
                     Visibility="{Binding NoMessages, Converter={StaticResource Vis}}" />
          <Button Style="{StaticResource Link}" Content="{Binding EarlierText}" Command="{Binding ShowEarlierCommand}"
                  HorizontalAlignment="Center" FontSize="12" Margin="0,0,0,12"
                  Visibility="{Binding HasEarlier, Converter={StaticResource Vis}}" />
          <ItemsControl ItemsSource="{Binding Messages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,16">
                  <!-- You -->
                  <Border HorizontalAlignment="Right" MaxWidth="420" CornerRadius="12" Padding="12,8" Background="#1F808080"
                          Visibility="{Binding IsUser, Converter={StaticResource Vis}}">
                    <ItemsControl ItemsSource="{Binding Segments}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <TextBox Style="{StaticResource Prose}" Text="{Binding Text, Mode=OneWay}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                  <!-- AI -->
                  <StackPanel Visibility="{Binding IsAssistant, Converter={StaticResource Vis}}">
                    <ItemsControl ItemsSource="{Binding Activities}" Margin="0,0,0,6">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <DockPanel Margin="0,1">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="11"
                                       Opacity="0.7" Margin="0,2,8,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Opacity="0.72"
                                       FontFamily="{StaticResource Mono}" />
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Style="{StaticResource Prose}" Text="{Binding StreamText, Mode=OneWay}"
                             Visibility="{Binding IsStreaming, Converter={StaticResource Vis}}" />
                    <ItemsControl ItemsSource="{Binding Segments}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,10">
                            <TextBox Style="{StaticResource Prose}" Text="{Binding Text, Mode=OneWay}"
                                     Visibility="{Binding IsText, Converter={StaticResource Vis}}" />
                            <!-- Code block: neutral box -->
                            <Border CornerRadius="8" BorderThickness="1" BorderBrush="#33808080" Background="#12808080"
                                    Visibility="{Binding IsCode, Converter={StaticResource Vis}}">
                              <StackPanel>
                                <DockPanel Margin="10,5,6,3">
                                  <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Command="{Binding CopyCommand}" ToolTip="Copy code">
                                    <StackPanel Orientation="Horizontal">
                                      <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="11" Margin="0,2,5,0" />
                                      <TextBlock Text="{Binding CopyLabel}" FontSize="11" />
                                    </StackPanel>
                                  </Button>
                                  <TextBlock Text="&#xE943;" FontFamily="{StaticResource Icons}" FontSize="11" Opacity="0.7" Margin="0,2,6,0" />
                                  <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.7" />
                                </DockPanel>
                                <Border BorderThickness="0,1,0,0" BorderBrush="#26808080" Padding="10,8">
                                  <TextBox Style="{StaticResource Prose}" Text="{Binding Text, Mode=OneWay}" TextWrapping="NoWrap"
                                           HorizontalScrollBarVisibility="Auto" FontFamily="{StaticResource Mono}" FontSize="12" />
                                </Border>
                              </StackPanel>
                            </Border>
                            <!-- Command block: tinted box so commands stand apart from code -->
                            <Border CornerRadius="8" BorderThickness="1" BorderBrush="#5530A46C" Background="#1A30A46C"
                                    Visibility="{Binding IsCommand, Converter={StaticResource Vis}}">
                              <StackPanel>
                                <DockPanel Margin="10,5,6,3">
                                  <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Command="{Binding CopyCommand}" ToolTip="Copy command">
                                    <StackPanel Orientation="Horizontal">
                                      <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="11" Margin="0,2,5,0" />
                                      <TextBlock Text="{Binding CopyLabel}" FontSize="11" />
                                    </StackPanel>
                                  </Button>
                                  <TextBlock Text="&#xE756;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="#30A46C" Margin="0,2,6,0" />
                                  <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="#30A46C" />
                                </DockPanel>
                                <Border BorderThickness="0,1,0,0" BorderBrush="#3330A46C" Padding="10,8">
                                  <TextBox Style="{StaticResource Prose}" Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap"
                                           FontFamily="{StaticResource Mono}" FontSize="12" />
                                </Border>
                              </StackPanel>
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Tasks -->
      <ScrollViewer Visibility="{Binding IsTasksView, Converter={StaticResource Vis}}" VerticalScrollBarVisibility="Auto" Padding="14">
        <StackPanel>
          <TextBlock Text="Plan or issue list" FontWeight="SemiBold" Margin="0,0,0,6" />
          <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="Paste a file path (.xlsx, .csv, .docx, .md, .txt). In Explorer: Shift + right-click the file → Copy as path." />
          <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Attach open file" Margin="6,0,0,0" Command="{Binding AttachOpenFileCommand}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Attach" Margin="6,0,0,0" Command="{Binding AttachCommand}" />
            <TextBox Style="{StaticResource Input}" Text="{Binding AttachPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </DockPanel>
          <StackPanel Visibility="{Binding HasTasks, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding TaskHeader}" FontWeight="SemiBold" Margin="0,4,0,6" />
            <WrapPanel Margin="0,0,0,8">
              <Button Style="{StaticResource Primary}" Content="Run next" Margin="0,0,6,6" Command="{Binding RunNextTaskCommand}" />
              <Button Style="{StaticResource Ghost}" Content="Export results" Margin="0,0,6,6" Command="{Binding ExportTasksCommand}" />
              <Button Style="{StaticResource Ghost}" Content="Remove list" Margin="0,0,12,6" Command="{Binding ClearTasksCommand}" />
              <CheckBox Content="Auto-continue" Margin="0,0,12,6" VerticalAlignment="Center"
                        Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}"
                        IsChecked="{Binding AutoContinue, Mode=TwoWay}" />
              <CheckBox Content="Commit after each task" Margin="0,0,0,6" VerticalAlignment="Center"
                        Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}"
                        IsChecked="{Binding CommitEachTask, Mode=TwoWay}" />
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding TaskRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="0,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Skip" Padding="8,2" Margin="6,0,0,0" Command="{Binding SkipCommand}" />
                      <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Run" Padding="8,2" Margin="6,0,0,0" Command="{Binding RunCommand}" />
                      <TextBlock Text="{Binding Line}" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" />
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- History -->
      <ScrollViewer Visibility="{Binding IsHistoryView, Converter={StaticResource Vis}}" VerticalScrollBarVisibility="Auto" Padding="14">
        <StackPanel>
          <TextBlock Text="Chats in this solution" FontWeight="SemiBold" Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding History}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource Ghost}" Content="{Binding Title}" Command="{Binding OpenCommand}"
                        HorizontalContentAlignment="Left" BorderThickness="0" Padding="8,6" Margin="0,1" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Settings -->
      <ScrollViewer Visibility="{Binding IsSettingsView, Converter={StaticResource Vis}}" VerticalScrollBarVisibility="Auto" Padding="14">
        <StackPanel>
          <TextBlock Text="Account" FontWeight="SemiBold" Margin="0,0,0,4" />
          <TextBlock Text="{Binding AccountText}" TextWrapping="Wrap" FontSize="13" />
          <TextBlock Style="{StaticResource Muted}" Text="{Binding UsageText}" TextWrapping="Wrap" Margin="0,2,0,8" />
          <Button Style="{StaticResource Ghost}" Content="{Binding ConnectLabel}" HorizontalAlignment="Left" Margin="0,0,0,16" Command="{Binding ConnectCommand}" />

          <TextBlock Text="Model" FontWeight="SemiBold" Margin="0,0,0,4" />
          <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Use model" Margin="6,0,0,0" Command="{Binding SetModelCommand}" />
            <ComboBox IsEditable="True" ItemsSource="{Binding ModelOptions}"
                      Text="{Binding ModelInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          </DockPanel>

          <StackPanel Visibility="{Binding IsGemini, Converter={StaticResource Vis}}" Margin="0,0,0,16">
            <TextBlock Text="Gemini API key" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="Stored encrypted for your Windows user. Never paste it anywhere else." />
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Remove" Margin="6,0,0,0" Command="{Binding RemoveGeminiKeyCommand}" />
              <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Save" Margin="6,0,0,0" Command="{Binding SaveGeminiKeyCommand}" />
              <TextBox Style="{StaticResource Input}" Text="{Binding GeminiKeyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
          </StackPanel>

          <TextBlock Text="Approvals and context" FontWeight="SemiBold" Margin="0,0,0,6" />
          <CheckBox Margin="0,0,0,4" Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}"
                    IsChecked="{Binding AutoApproveReads, Mode=TwoWay}"
                    Content="Approve read-only commands automatically (search, read, git status/diff/log)" />
          <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="20,0,0,8"
                     Text="Edits, builds and anything unclear still ask. Commands with ; &amp;&amp; | &gt; are never treated as read-only." />
          <CheckBox Margin="0,0,0,4" Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}"
                    IsChecked="{Binding IncludeEditorContext, Mode=TwoWay}" Content="Send the open file and selection with each message" />
          <CheckBox Margin="0,0,0,4" Foreground="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}"
                    IsChecked="{Binding CommitEachTask, Mode=TwoWay}" Content="Commit after each task" />
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Approval card -->
    <Border Grid.Row="3" Margin="14,4,14,6" CornerRadius="10" BorderThickness="1" BorderBrush="#C99A2E"
            Background="{DynamicResource {x:Static styles:VsBrushes.WindowKey}}"
            Visibility="{Binding HasApproval, Converter={StaticResource Vis}}">
      <StackPanel>
        <DockPanel Margin="12,10,12,6">
          <Border DockPanel.Dock="Left" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" Background="#332F6FEB"
                  Visibility="{Binding BadgeNormal, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="Bold" Foreground="#4D8DF7" />
          </Border>
          <Border DockPanel.Dock="Left" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" Background="#33E5534B"
                  Visibility="{Binding BadgeDanger, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="Bold" Foreground="#E5534B" />
          </Border>
          <TextBlock Text="{Binding ApprovalHeadline}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13"
                     Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" />
        </DockPanel>
        <TextBlock Text="⚠ Deletes files. Check the list before approving." Foreground="#E5534B" FontWeight="SemiBold"
                   Margin="12,0,12,6" Visibility="{Binding ApprovalDeletes, Converter={StaticResource Vis}}" />
        <TextBlock Style="{StaticResource Muted}" Text="{Binding ApprovalWhy}" TextWrapping="Wrap" FontSize="13" Margin="12,0,12,8" />
        <Border Margin="12,0,12,10" CornerRadius="6" Padding="10,8" Background="#14808080"
                Visibility="{Binding HasCommand, Converter={StaticResource Vis}}">
          <TextBox Style="{StaticResource Prose}" Text="{Binding ApprovalCommand, Mode=OneWay}" FontFamily="{StaticResource Mono}" FontSize="12"
                   Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" MaxHeight="120" VerticalScrollBarVisibility="Auto" />
        </Border>
        <Border Margin="12,0,12,10" CornerRadius="6" Padding="10,8" Background="#14808080" MaxHeight="200"
                Visibility="{Binding HasDiff, Converter={StaticResource Vis}}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding DiffLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <TextBlock Text="{Binding Text}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="#2EA043"
                               Visibility="{Binding IsAdd, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding Text}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="#E5534B"
                               Visibility="{Binding IsDel, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding Text}" FontFamily="{StaticResource Mono}" FontSize="12" FontWeight="SemiBold" Opacity="0.8"
                               Visibility="{Binding IsHeader, Converter={StaticResource Vis}}" />
                    <TextBlock Text="{Binding Text}" FontFamily="{StaticResource Mono}" FontSize="12" Opacity="0.7"
                               Visibility="{Binding IsContext, Converter={StaticResource Vis}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <DockPanel Margin="12,0,12,12">
          <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Open diff" Command="{Binding ViewDiffCommand}"
                  Visibility="{Binding HasDiff, Converter={StaticResource Vis}}" />
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource Primary}" Content="Approve" Margin="0,0,8,0" Padding="14,6" Command="{Binding ApproveCommand}" />
            <Button Style="{StaticResource Ghost}" Content="Decline" Padding="14,6" Command="{Binding DeclineCommand}" />
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- Status -->
    <TextBlock Grid.Row="4" Style="{StaticResource Muted}" Text="{Binding Status}" TextWrapping="Wrap" Margin="14,2,14,4" />

    <!-- Composer -->
    <Border Grid.Row="5" Margin="14,4,14,14" CornerRadius="10" BorderThickness="1" Padding="10,8"
            BorderBrush="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}"
            Background="{DynamicResource {x:Static styles:VsBrushes.WindowKey}}">
      <StackPanel>
        <TextBox Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="44" MaxHeight="160" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"
                 Foreground="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}"
                 CaretBrush="{DynamicResource {x:Static styles:VsBrushes.WindowTextKey}}" FontSize="13"
                 ToolTip="Enter sends · Shift+Enter adds a new line">
          <!-- Our Enter binding runs before the text box's own one, so Enter sends and Shift+Enter still adds a line. -->
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding SendCommand}" CommandParameter="{Binding Prompt}" />
            <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SendCommand}" CommandParameter="{Binding Prompt}" />
          </TextBox.InputBindings>
        </TextBox>
        <DockPanel Margin="0,6,0,0">
          <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Padding="12,5" Margin="8,0,0,0" ToolTip="Send (Enter)"
                  Command="{Binding SendCommand}" CommandParameter="{Binding Prompt}">
            <TextBlock Text="&#xE724;" FontFamily="{StaticResource Icons}" FontSize="13" />
          </Button>
          <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Stop" Padding="10,5" Margin="8,0,0,0"
                  Command="{Binding StopCommand}" Visibility="{Binding IsRunning, Converter={StaticResource Vis}}" />
          <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding ModelInput}" VerticalAlignment="Center" Margin="8,0,0,0" />
          <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="Enter send · Shift+Enter new line" VerticalAlignment="Center" Margin="8,0,0,0" />
          <StackPanel Orientation="Horizontal">
            <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IncludeEditorContext, Mode=TwoWay}"
                          ToolTip="Send the open file and selection">
              <TextBlock Text="@ open file · selection" FontSize="12" />
            </ToggleButton>
            <Button Style="{StaticResource Link}" Command="{Binding ShowTasksCommand}" ToolTip="Attach a plan or issue list" Margin="10,0,0,0">
              <TextBlock Text="&#xE723;" FontFamily="{StaticResource Icons}" FontSize="13"
                         Foreground="{DynamicResource {x:Static styles:VsBrushes.GrayTextKey}}" />
            </Button>
          </StackPanel>
        </DockPanel>
      </StackPanel>
    </Border>
  </Grid>
</DataTemplate>
